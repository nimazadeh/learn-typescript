{
  "name": "typescript-visual-mastery-studio",
  "version": "2.0.0",
  "description": "استودیو بصری جامع آموزش گام‌به‌گام TypeScript بر اساس نقشه راه رسمی roadmap.sh/typescript با HTML، CSS و JavaScript خالص",
  "type": "module",
  "scripts": {
    "start": "node server.mjs",
    "dev": "node server.mjs",
    "validate": "node tools/validate-content.mjs",
    "smoke": "node tools/smoke.mjs",
    "test:engine": "node --test tools/ts-engine.test.mjs",
    "link": "node --experimental-vm-modules --no-warnings tools/link-check.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"tools/**/*.mjs\" \"lib/**/*.mjs\" \"src/**/*.js\" server.mjs eslint.config.js",
    "format:check": "prettier --check \"tools/**/*.mjs\" \"lib/**/*.mjs\" \"src/**/*.js\" server.mjs eslint.config.js",
    "audit:content": "node tools/audit-compile-content.mjs",
    "audit:a11y": "node tools/audit-a11y.mjs",
    "audit:css": "node tools/audit-css.mjs",
    "audit": "node tools/run-audits.mjs",
    "test": "npm run validate && npm run link && npm run test:engine && npm run lint && npm run audit:css",
    "qa": "npm run test && npm run audit"
  },
  "dependencies": {
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "typescript": "5.9.3",
    "vazirmatn": "^33.0.3"
  },
  "devDependencies": {
    "axe-core": "^4.14.0",
    "eslint": "^10.13.0",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10"
  },
  "engines": {
    "node": ">=22"
  }
}
